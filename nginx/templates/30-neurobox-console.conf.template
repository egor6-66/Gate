# Сосед: NeuroBox, его пульт. Слушает и главный порт, и свой 8443: витрина, ради которой пульт
# уезжал с главного, снесена, а адрес на 8443 у людей уже в руках — оба живут, пока не появится
# второй сосед. Тогда главный порт уйдёт ему, и здесь останется одна строка.
#
# Порт, а не путь на общем, и вот почему: браузер считает разными только те места, у которых
# различаются схема, имя ИЛИ порт. Пути он не различает вовсе, и соседи на общем порту оказались
# бы для него одним местом — общее хранилище, общие права, дыра в одном становится дырой в другом.
#
# Цена, которую порты НЕ снимают: куки портами не разделяются. Поэтому пульт их не использует
# вовсе. Когда появится домен, соседи разъедутся по поддоменам, и порты отсюда уйдут.

server {
    listen 443 ssl;
    listen 8443 ssl;
    server_name _;

    location / {
        set $neighbour "console:80";
        proxy_pass http://$neighbour;

        # Пульт слушает ход работы агента потоком событий. Буферизация здесь означала бы, что
        # шаги копятся у посредника и приезжают пачкой в конце — то есть ровно тогда, когда
        # они уже не нужны.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}
