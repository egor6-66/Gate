# Сосед: демка статбордов (свой репозиторий, свой compose). На своём порту — по общему правилу.
#
# Отдаёт статику своим nginx, и ответы её ручек лежат в том же образе файлами. Путей к соседям
# здесь нет, потому что соседей у неё нет вовсе.

server {
    listen 9500 ssl;
    server_name _;

    location / {
        set $neighbour "statboard:80";
        proxy_pass http://$neighbour;
    }
}
