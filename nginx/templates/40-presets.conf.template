# Сосед: служба пресетов зоны скинов (бокс, compose neurobox). На своём порту — по общему правилу.
#
# Открыта наружу по слову человека (2026-09-09) для разработки витрины с ноутбука против боевых
# данных. Авторизации у службы нет: кто знает адрес, тот читает и пишет. Это свойство службы,
# вход его не чинит и не маскирует; пределы (записей на вид, байт всего) держит сама служба.

server {
    listen 9787 ssl;
    server_name _;

    location / {
        set $neighbour "presets:8787";
        proxy_pass http://$neighbour;
    }
}
