# Сосед: windshift.
#
# Порт 443. Знать про него нужно ровно три вещи: по какому порту его зовут снаружи, в какой сети
# докера он живёт и как называется. Всё остальное — его дело.

server {
    listen 443 ssl;
    server_name _;

    location / {
        # Имя в переменной, а не прямо в proxy_pass: только так nginx спрашивает адрес заново на
        # каждый запрос, а не запоминает его навсегда при старте.
        set $neighbour "windshift:8080";
        proxy_pass http://$neighbour;

        # Продукт держит долгие соединения. Час — чтобы вход не рвал их раньше, чем сосед сам
        # решит, что разговор окончен.
        proxy_read_timeout 3600s;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
