# Сосед: NeuroBox, его пульт.
#
# ОТДЕЛЬНЫЙ ПОРТ, а не путь на общем — это решение, а не случайность. Браузер считает разными
# только те места, у которых различаются схема, имя ИЛИ порт. Живи пульт на общем порту по пути
# `/box/`, для браузера он был бы тем же местом, что и сосед: общее хранилище, общие права,
# и дыра в одном стала бы дырой в другом. Разные порты держат их врозь без всякого доверия
# между продуктами.
#
# Останется цена: куки портами НЕ разделяются, поэтому пульт их не использует вовсе.
# Когда появится домен, соседи разъедутся по поддоменам, и порт отсюда уйдёт.

server {
    listen 8443 ssl;
    server_name _;

    location / {
        set $neighbour "console:80";
        proxy_pass http://$neighbour;

        # Пульт слушает ход работы агента потоком событий. Буферизация здесь означала бы, что
        # шаги копятся у посредника и приезжают пачкой в конце — то есть ровно тогда, когда
        # они уже не нужны.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}
