# Сосед: приватный реестр пакетов (бокс, compose neurobox). На своём порту — по общему правилу.
#
# Читать разрешено всем, публиковать — только по учётной записи; так решено заявкой. Вход этого
# не меняет и не маскирует: разграничение держит сам реестр.

server {
    listen 9873 ssl;
    server_name _;

    location / {
        set $neighbour "registry:4873";
        proxy_pass http://$neighbour;

        # Тела пакетов бывают в десятки мегабайт, а npm шлёт их одним запросом: предел по
        # умолчанию (1 МБ) рубил бы публикацию на ровном месте. Ноль — предела нет.
        client_max_body_size 0;

        # Реестр строит ссылки на тела пакетов из адреса, по которому к нему пришли. Без этих
        # заголовков он назовёт свой внутренний порт, и установка в чужом проекте пойдёт не туда.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Публикация большого пакета и выкачивание кэша с npmjs длятся дольше обычного запроса.
        proxy_read_timeout 10m;
        proxy_send_timeout 10m;
    }
}
