# Сосед: windshift. На своём порту — по общему правилу: браузер держит соседей врозь только когда
# у них разные схема, имя или порт, а пути он не различает вовсе.
#
# Живёт в том же compose, что и бокс (машина одна), но продуктом бокса не является: своя база,
# свой цикл выпуска, своя ветка. Вход знает о нём ровно три вещи — порт, сеть, имя контейнера.

server {
    listen 9443 ssl;
    server_name _;

    location / {
        set $neighbour "windshift:8080";
        proxy_pass http://$neighbour;

        # Продукт держит долгие соединения (живые обновления в интерфейсе). Час — чтобы вход не
        # рвал их раньше, чем сосед сам решит, что разговор окончен.
        proxy_read_timeout 3600s;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Вложения и импорт: у продукта свои размеры, и обрезать их входом значит ломать то, чего
        # вход не понимает.
        client_max_body_size 0;
    }
}
