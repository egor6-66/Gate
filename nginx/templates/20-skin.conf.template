# Сосед: витрина зоны скинов. Стоит на главном порту — это то, что показывают людям.
#
# Пульт бокса, который жил здесь раньше, переехал на свой порт (30-neurobox-console): второй
# сосед получает порт, а не путь — браузер считает разными только места с разной схемой, именем
# ИЛИ портом, а пути не различает вовсе. Разбор в README.

server {
    listen 443 ssl;
    server_name _;

    location / {
        set $neighbour "skin-web:80";
        proxy_pass http://$neighbour;

        # За витриной, тем же источником, живут чат бокса и служба пресетов: ответ чата ждётся
        # синхронно и может идти минуты, буферизация превратила бы его в обрыв по таймауту.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}
