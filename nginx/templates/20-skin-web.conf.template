# Сосед: витрина зоны скинов. На главном порту — она то, ради чего к машине приходят люди.
#
# Витрина отдаёт с одного своего источника и себя, и соседей: бокс под `/api`, службу пресетов
# под `/presets`. Разводит их её собственный nginx, а не этот: адреса впечатаны в её бандл
# относительными, и одна сборка годится и на петле, и за входом.

server {
    listen 443 ssl;
    server_name _;

    location / {
        set $neighbour "skin-web:80";
        proxy_pass http://$neighbour;

        # Внутри неё живёт чат с агентом: ответ идёт потоком событий и ждётся минутами.
        # Буферизация превратила бы поток в один пакет в конце, а короткий таймаут — в обрыв.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}
