# Сертификат — общий для всех соседей, объявлен ОДИН раз.
#
# Он выписан на машину, а не на продукт: продуктов за входом несколько, и каждому свой
# сертификат означал бы, что добавление соседа требует ещё одной выдачи. Объявление стоит здесь,
# на уровне всего http, и достаётся каждому серверу ниже само.

ssl_certificate     /certs/certificates/${GATE_HOST}.crt;
ssl_certificate_key /certs/certificates/${GATE_HOST}.key;

ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;

# Общее для всех соседей. Стоит здесь, а не повторяется в каждом файле: повторённая настройка
# однажды разъезжается, и разницу замечают не сразу.
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto https;

# Имя соседа разрешается на КАЖДЫЙ запрос, а не один раз при старте. Без этого вход запоминает
# адрес контейнера навсегда, и первый же перезапуск соседа даёт 502 при живом соседе — ошибка,
# по которой не догадаешься о причине. 127.0.0.11 — служба имён докера.
resolver 127.0.0.11 valid=10s ipv6=off;
