# Образец окружения. Скопируй в .env и правь — .env в гит не попадает никогда.
#
# Здесь только то, что вход действительно читает. Переменная, которую никто не читает, выглядит
# рабочей ручкой и врёт.

# Имя, по которому машину зовут снаружи. Пока это адрес, дальше будет домен — тогда меняется
# ровно эта строка, и на неё же выпишется сертификат.
GATE_HOST=144.31.61.229

# Почта для сертификата: на неё придёт письмо, если продление сломается и срок начнёт истекать.
# Ящик, который читают. Иначе первым о просрочке узнает посетитель.
ACME_EMAIL=
